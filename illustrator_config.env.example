# NovelAI 配图工作站 · 端点与密钥模板
#
# 用法：复制本文件为同目录的 .env，再填入真实值。
#     cp illustrator_config.env.example .env
#
# .env 已被 .gitignore 忽略；本模板不含任何真实地址或密钥，可以入库。
# 所有字段都可以留空，留空表示未配置。

# ── 主 LLM（通用任务）─────────────────────────────
LLM_URL=
LLM_KEY=

# ── 分任务 LLM（留空时回落到主 LLM）───────────────
LLM_CHARACTER_DNA_URL=
LLM_CHARACTER_DNA_KEY=
LLM_SCENE_URL=
LLM_SCENE_KEY=
LLM_NAI_TAGS_URL=
LLM_NAI_TAGS_KEY=
LLM_TRIM_URL=
LLM_TRIM_KEY=

# ── NovelAI 官方接口 ─────────────────────────────
# NAI_URL 一般填 https://image.novelai.net
NAI_URL=
NAI_TOKEN=

# ── 本地代理（可选）──────────────────────────────
PROXY_URL=

# ── 接口预设（按 illustrator_config.json 里的 preset id 命名）──
# 格式：LLM_PRESET_<预设ID>_URL / LLM_PRESET_<预设ID>_KEY
# 例：LLM_PRESET_1781579277070_URL=https://api.example.com/v1
#     LLM_PRESET_1781579277070_KEY=sk-xxxx
